<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <DisableImplicitFrameworkReferences>false</DisableImplicitFrameworkReferences>
    <RootNamespace>CvGenerator.App</RootNamespace>
    <ApplicationIcon />
    <AssemblyName>CvGenerator</AssemblyName>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CvGenerator.Core\CvGenerator.Core.csproj" />
    <ProjectReference Include="..\CvGenerator.Docx\CvGenerator.Docx.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="wwwroot\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <!-- Ship Templates next to the exe (debug + publish). -->
  <ItemGroup>
    <None Include="..\..\Templates\**\*"
          Link="Templates\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Condition="Exists('..\..\Templates')" />
  </ItemGroup>
</Project>
