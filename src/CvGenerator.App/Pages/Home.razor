@page "/"
@using CvGenerator.App.Services
@using CvGenerator.Core.Models
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@inject AppState State
@inject IJSRuntime JS
@implements IDisposable

<div class="shell">
    <header class="topbar">
        <div class="brand-wrap">
            <div class="brand">CV Generator</div>
            <div class="brand-sub">Template-driven export</div>
        </div>
        <div class="topbar-right">
            <span class="path-chip" title="@State.OutputRoot">@State.OutputRoot</span>
            <button class="btn" type="button" @onclick="BrowseRoot">Browse output</button>
            <button class="btn" type="button" @onclick="RefreshAll">Refresh</button>
            <button class="btn" type="button" @onclick="OpenHelp" title="Template &amp; JSON grammar">Help</button>
        </div>
    </header>

    @if (_helpOpen)
    {
        <div class="help-overlay" @onclick="CloseHelp">
            <div class="help-dialog" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="help-title">
                <div class="help-header">
                    <div id="help-title" class="help-title">@GrammarHelpText.Title</div>
                    <div class="help-header-actions">
                        <button class="btn" type="button" @onclick="CopyHelp">@(_helpCopied ? "Copied" : "Copy all")</button>
                        <button class="btn" type="button" @onclick="CloseHelp">Close</button>
                    </div>
                </div>
                <pre class="help-body" tabindex="0">@GrammarHelpText.Body</pre>
            </div>
        </div>
    }

    @if (State.IsLibreOfficeReady)
    {
        <div class="status-banner ok">
            <div class="status-banner-text">
                <strong>LibreOffice ready</strong>
                <span class="muted"> — @State.ResolvedLibreOfficePath</span>
            </div>
            <div class="status-banner-actions">
                <button class="btn btn-ghost" type="button" @onclick="BrowseLibreOffice">Change path</button>
                <button class="btn btn-ghost" type="button" @onclick="ClearLibreOffice">Use auto-detect</button>
            </div>
        </div>
    }
    else
    {
        <div class="status-banner bad">
            <div class="status-banner-text">
                <strong>LibreOffice not found</strong>
                — Install it, then click <em>Set LibreOffice</em> and choose
                <code>…\LibreOffice\program\soffice.exe</code>. JSON/DOCX/notes still export without it (status: Partial).
            </div>
            <div class="status-banner-actions">
                <button class="btn btn-primary" type="button" @onclick="BrowseLibreOffice">Set LibreOffice</button>
                <button class="btn" type="button" @onclick="DownloadLibreOffice">Download</button>
            </div>
        </div>
    }

    <div class="workspace">
        <section class="panel">
            <div class="panel-title">CV JSON</div>
            <div class="toolbar">
                <button class="btn" type="button" @onclick="OpenJson">Open</button>
                <button class="btn" type="button" @onclick="FormatJson">Format</button>
                <button class="btn" type="button" @onclick="OnJsonChanged">Validate</button>
            </div>

            @if (State.JsonMarks.Any())
            {
                <div class="json-mark-bar">
                    @foreach (var mark in State.JsonMarks)
                    {
                        <span class="@(mark.Severity == IssueSeverity.Error ? "json-chip error" : "json-chip warn")" title="@mark.Reason">
                            @mark.Path
                        </span>
                    }
                </div>
            }

            <div class="json-editor-wrap">
                <div class="json-gutter" aria-hidden="true" style="@JsonGutterWidthStyle">
                    <div class="json-gutter-inner">@JsonLineNumbers</div>
                </div>
                <div class="json-code">
                    <pre class="json-highlight" aria-hidden="true">@((MarkupString)State.JsonHighlightHtml)</pre>
                    <textarea class="json-editor"
                              @ref="_jsonEditor"
                              @bind="State.JsonText"
                              @bind:event="oninput"
                              @bind:after="OnJsonChanged"
                              @onscroll="OnJsonScroll"
                              spellcheck="false"></textarea>
                </div>
            </div>
        </section>

        <section class="panel">
            <div class="panel-title">Template</div>
            <div class="toolbar toolbar-align">
                <select class="select-wide" value="@State.SelectedTemplateId" @onchange="OnTemplateChanged">
                    @if (!State.Templates.Any())
                    {
                        <option value="">No templates found</option>
                    }
                    else
                    {
                        @foreach (var t in State.Templates)
                        {
                            <option value="@t.Id">@t.Id</option>
                        }
                    }
                </select>
                <button class="btn" type="button" @onclick="ImportTemplate">Import</button>
                <button class="btn" type="button" @onclick="RefreshTemplates">Refresh</button>
            </div>

            <div class="panel-title">Placeholders found</div>
            <div class="placeholder-list">
                @if (!State.PlaceholderBindings.Any())
                {
                    <div class="empty">Select or import a .docx template to inspect placeholders.</div>
                }
                else
                {
                    @foreach (var b in State.PlaceholderBindings)
                    {
                        <div class="placeholder-item">
                            <span class="ph-token">@((MarkupString)FormatPlaceholderHtml(b.Placeholder))</span>
                            <span class="ph-bind @BindClass(b.State)" title="@b.Display">
                                <span class="ph-bind-state">@BindLabel(b.State)</span>
                                <span class="ph-bind-value">@b.Display</span>
                            </span>
                        </div>
                    }
                }
            </div>

            <div class="panel-title">Output preview path</div>
            <div class="preview-path-row">
                <div class="preview-path" title="@State.OutputPreview">@State.OutputPreview</div>
                <button class="btn btn-icon @(State.ShowCopyCheckIcon ? "btn-icon-ok" : "")"
                        type="button"
                        title="@(State.IsCopyArmed ? "Copy output directory path" : "Copied")"
                        disabled="@(!State.IsCopyArmed)"
                        @onclick="CopyOutputPath"
                        aria-label="Copy output directory path">
                    @if (State.ShowCopyCheckIcon)
                    {
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="M5 12.5l5 5L19 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    }
                    else
                    {
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <rect x="9" y="9" width="11" height="11" rx="2" stroke="currentColor" stroke-width="2"/>
                            <path d="M5 15V5a2 2 0 0 1 2-2h10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                        </svg>
                    }
                </button>
            </div>
        </section>
    </div>

    <section class="debug">
        <div class="debug-header">
            <div class="debug-title">Debug Error List</div>
            <div class="debug-actions">
                <select class="select-compact" @bind="State.IssueFilter" @bind:after="Notify">
                    <option value="All">All</option>
                    <option value="Errors">Errors only</option>
                    <option value="Warnings">Warnings</option>
                </select>
                <button class="btn" type="button" @onclick="CopyIssues">Copy</button>
                <button class="btn" type="button" @onclick="ClearIssues">Clear</button>
            </div>
        </div>
        <div class="debug-list">
            @{
                var rows = State.FilteredIssues().ToList();
            }
            @if (!rows.Any())
            {
                <div class="debug-row"><span class="muted">No issues.</span></div>
            }
            else
            {
                @foreach (var issue in rows)
                {
                    <div class="debug-row">
                        <span class="@SeverityClass(issue.Severity)">@issue.Severity.ToString().ToUpperInvariant()</span>
                        <span>@issue.Step</span>
                        <span>
                            @issue.Message
                            @if (!string.IsNullOrEmpty(issue.Path))
                            {
                                <span class="muted"> [@issue.Path]</span>
                            }
                        </span>
                    </div>
                }
            }
        </div>
    </section>

    <footer class="actionbar">
        <div class="actionbar-left">
            <button class="btn btn-primary" type="button" disabled="@State.IsBusy" @onclick="GenerateAll">
                @(State.IsBusy ? "Generating…" : "Generate All")
            </button>
            <button class="btn" type="button"
                    disabled="@(string.IsNullOrEmpty(State.LastOutputDirectory))"
                    @onclick="OpenOutput">
                Open output folder
            </button>
        </div>
        <div class="status @StatusClass(State.Status)">status: @State.Status</div>
    </footer>
</div>

@code {
    private ElementReference _jsonEditor;

    private bool _firstRender = true;
    private bool _helpOpen;
    private bool _helpCopied;

    protected override void OnInitialized()
    {
        State.Changed += OnChanged;
        State.RefreshLibreOfficeStatus();
        State.RefreshPreviewAndLiveValidation();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try { await JS.InvokeVoidAsync("cvBindJsonEditorKeys", _jsonEditor); }
        catch { /* ignore */ }

        if (!firstRender || !_firstRender)
            return;

        _firstRender = false;
        // Ensure highlight mirror matches textarea on first paint.
        State.RefreshPreviewAndLiveValidation();
        StateHasChanged();
    }

    public void Dispose() => State.Changed -= OnChanged;

    private static string FormatPlaceholderHtml(CvGenerator.Docx.Services.PlaceholderInfo p)
    {
        var token = System.Net.WebUtility.HtmlEncode(p.Token);
        return p.Kind switch
        {
            "array-start" => FormatArrayMarkerHtml("ArrayStart", p),
            "array-end" => FormatArrayMarkerHtml("ArrayEnd", p),
            "join-start" => FormatKeywordHtml("JoinStart"),
            "join-end" => FormatKeywordHtml("JoinEnd"),
            "loop-field" => ColorizeSimpleToken(token),
            _ => ColorizeSimpleToken(token)
        };
    }

    private static string FormatKeywordHtml(string keyword)
        => $"<span class=\"ph-brace\">$</span><span class=\"ph-brace\">{{</span><span class=\"ph-keyword\">{keyword}</span><span class=\"ph-brace\">}}</span>";

    private static string FormatArrayMarkerHtml(string keyword, CvGenerator.Docx.Services.PlaceholderInfo p)
    {
        var source = System.Net.WebUtility.HtmlEncode(p.JsonPath ?? "");
        var alias = string.IsNullOrEmpty(p.Alias)
            ? ""
            : $" <span class=\"ph-var\">{System.Net.WebUtility.HtmlEncode(p.Alias)}</span>";
        return $"<span class=\"ph-brace\">$</span><span class=\"ph-brace\">{{</span><span class=\"ph-keyword\">{keyword}</span> <span class=\"ph-var\">{source}</span>{alias}<span class=\"ph-brace\">}}</span>";
    }

    private static string ColorizeSimpleToken(string encodedToken)
    {
        // encodedToken looks like ${...}
        if (!encodedToken.StartsWith("${", StringComparison.Ordinal) || !encodedToken.EndsWith("}", StringComparison.Ordinal))
            return $"<span class=\"ph-var\">{encodedToken}</span>";
        var inner = encodedToken[2..^1];
        return $"<span class=\"ph-brace\">$</span><span class=\"ph-brace\">{{</span><span class=\"ph-var\">{inner}</span><span class=\"ph-brace\">}}</span>";
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void Notify() => StateHasChanged();

    private void BrowseRoot() => State.BrowseOutputRoot();
    private void BrowseLibreOffice() => State.BrowseLibreOffice();
    private void ClearLibreOffice() => State.ClearLibreOfficePath();
    private void DownloadLibreOffice() => State.OpenLibreOfficeDownload();
    private void OpenJson() => State.OpenJsonFile();
    private void FormatJson() => State.FormatJson();
    private void ImportTemplate() => State.ImportTemplate();
    private void CopyOutputPath() => State.CopyOutputDirectoryPath();

    private void RefreshTemplates()
    {
        State.RefreshTemplates();
        StateHasChanged();
    }

    private void RefreshAll()
    {
        State.RefreshLibreOfficeStatus();
        State.RefreshTemplates();
        State.RefreshPreviewAndLiveValidation();
        StateHasChanged();
    }

    private async Task OnJsonChanged()
    {
        State.RefreshPreviewAndLiveValidation();
        StateHasChanged();
        try { await JS.InvokeVoidAsync("cvSyncJsonScroll", _jsonEditor); }
        catch { /* ignore */ }
    }

    private void OnTemplateChanged(ChangeEventArgs e)
    {
        State.SelectTemplate(e.Value?.ToString());
    }

    private async Task GenerateAll() => await State.GenerateAllAsync();
    private void OpenOutput() => State.OpenLastOutput();
    private void ClearIssues() => State.ClearIssues();

    private int JsonLineCount
    {
        get
        {
            var text = State.JsonText ?? "";
            var lines = 1;
            for (var i = 0; i < text.Length; i++)
            {
                if (text[i] == '\n')
                    lines++;
            }

            return lines;
        }
    }

    private string JsonLineNumbers
    {
        get
        {
            var lines = JsonLineCount;
            var sb = new System.Text.StringBuilder(lines * 4);
            for (var i = 1; i <= lines; i++)
            {
                if (i > 1) sb.Append('\n');
                sb.Append(i);
            }

            return sb.ToString();
        }
    }

    private string JsonGutterWidthStyle
    {
        get
        {
            // VS Code-like: grow with digit count + comfortable padding-x
            var digits = Math.Max(2, JsonLineCount.ToString().Length);
            var ch = digits + 2; // extra breathing room
            return $"flex-basis: calc({ch}ch + 1.6rem); width: calc({ch}ch + 1.6rem);";
        }
    }

    private async Task OnJsonScroll(EventArgs _)
    {
        try { await JS.InvokeVoidAsync("cvSyncJsonScroll", _jsonEditor); }
        catch { /* ignore */ }
    }

    private void OpenHelp()
    {
        _helpOpen = true;
        _helpCopied = false;
    }

    private void CloseHelp()
    {
        _helpOpen = false;
        _helpCopied = false;
    }

    private async Task CopyHelp()
    {
        try
        {
            System.Windows.Clipboard.SetText(GrammarHelpText.Body);
            _helpCopied = true;
            StateHasChanged();
            await Task.Delay(1600);
            _helpCopied = false;
            StateHasChanged();
        }
        catch
        {
            // ignore
        }
    }

    private async Task CopyIssues()
    {
        var text = State.GetFilteredIssuesText();
        try
        {
            System.Windows.Clipboard.SetText(string.IsNullOrWhiteSpace(text) ? "(no issues)" : text);
        }
        catch
        {
            // ignore
        }

        await Task.CompletedTask;
    }

    private static string SeverityClass(IssueSeverity s) => s switch
    {
        IssueSeverity.Error => "sev-error",
        IssueSeverity.Warning => "sev-warning",
        _ => "sev-info"
    };

    private static string StatusClass(GenerationStatus s) => s switch
    {
        GenerationStatus.Success => "status-success",
        GenerationStatus.Partial => "status-partial",
        GenerationStatus.Failed => "status-failed",
        _ => "status-ready"
    };

    private static string BindClass(string state) => state switch
    {
        "ok" => "bind-ok",
        "missing" => "bind-missing",
        "empty" => "bind-empty",
        "partial" => "bind-partial",
        _ => "bind-marker"
    };

    private static string BindLabel(string state) => state switch
    {
        "ok" => "matched",
        "missing" => "missing",
        "empty" => "empty",
        "partial" => "partial",
        _ => "marker"
    };
}
