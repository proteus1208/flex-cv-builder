<Window x:Class="CvGenerator.App.Services.CursorOrbWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CV Generator Orb"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="False"
        Width="56"
        Height="56">
  <Grid IsHitTestVisible="False">
    <Ellipse x:Name="Orb"
             Width="36"
             Height="36"
             HorizontalAlignment="Center"
             VerticalAlignment="Center"
             Stroke="#3B82F6"
             StrokeThickness="2.5"
             Fill="#663B82F6"
             Opacity="0"
             RenderTransformOrigin="0.5,0.5">
      <Ellipse.RenderTransform>
        <ScaleTransform x:Name="OrbScale" ScaleX="0.55" ScaleY="0.55" />
      </Ellipse.RenderTransform>
    </Ellipse>
  </Grid>
</Window>
